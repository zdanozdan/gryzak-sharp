                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding KontrahentAdres}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Grid.Column="3" Text="{Binding PrzygotowalniaDisplay}"
                                                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                                                   FontSize="11" LineHeight="16"
