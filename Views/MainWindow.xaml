                                    <Button Content="Pobierz nadania" Command="{Binding FetchGlsPickupsCommand}"
                                            Height="35" Margin="5,0,0,0"
                                            ToolTip="Pobiera nadania GLS w wybranym zakresie i synchronizuje nr_listu z listą dokumentów"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

