                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsGlsPanelEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInGlsPreparingBox}" Value="False">
                                                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="4" Text="{Binding NadaniaDisplay}"
                                                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                                                   FontSize="11" LineHeight="16"
                                                                   ToolTip="{Binding NadaniaTooltip}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsGlsPanelEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsGlsPickedUp}" Value="False">
                                                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
