                            Padding="20,14" Margin="0,4,0,0" HorizontalAlignment="Center" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#1565C0" Data="M15.5,14h-0.79l-0.28,-0.27A6.471,6.471 0 0 0 16,9.5 6.5,6.5 0 1 0 9.5,16c1.61,0 3.09,-0.59 4.23,-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99,-5zm-6,0C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Wyszukaj po numerze zamówienia" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Kliknij, aby pobrać z API (używany jest tekst z pola wyszukiwania)" FontSize="12" Foreground="#37474F" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Brak załadowanych zamówień (bez aktywnego filtra) -->
                <StackPanel HorizontalAlignment="Center"
                            Visibility="{Binding EmptyListShowsNoOrdersMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📋 Brak zamówień" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Nie znaleziono zamówień do wyświetlenia" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Nadania GLS"
                      Visibility="{Binding IsGlsPanelEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
