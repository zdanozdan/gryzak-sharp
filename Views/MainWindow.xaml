                <StackPanel HorizontalAlignment="Center"
                            Visibility="{Binding EmptyListShowsFetchByNumberHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Brak wyników dla bieżącego filtra" FontSize="14" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,8"/>
