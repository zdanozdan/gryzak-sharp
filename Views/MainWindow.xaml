                                                                                <DataTrigger Binding="{Binding KontrahentNip}" Value="{x:Null}">
                                                                                    <Setter Property="Text" Value="Brak NIP"/>
                                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding KontrahentNip}" Value="">
                                                                                    <Setter Property="Text" Value="Brak NIP"/>
                                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Run.Style>
                                                                </Run>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding KontrahentAdres}" FontSize="11" Foreground="Gray"
                                                                       ToolTip="{Binding KontrahentAdres}"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
