                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="WZ" FontSize="12" FontWeight="Bold" Cursor="Hand" Tag="wz"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                       ToolTip="Wydanie zewnętrzne"
                                                       MouseLeftButtonDown="SubiektDocumentTypeChip_Click">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#90CAF9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubiektDocumentType}" Value="wz">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
