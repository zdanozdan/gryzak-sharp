                                                    Cursor="Hand" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE72C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Data" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Kontrahent" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Przygotowalnia" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                                                   Visibility="{Binding IsGlsPanelEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="4" Text="Nadania" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                                                   Visibility="{Binding IsGlsPanelEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="5" Text="Płatność" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
