                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSubiektLoading}" Value="False"/>
                                                <Condition Binding="{Binding HasSubiektLoadedDocuments}" Value="False"/>
