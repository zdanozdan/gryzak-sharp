                                                            <ColumnDefinition Width="90" MinWidth="90"/>
                                                            <ColumnDefinition Width="*" MinWidth="220"/>
                                                            <ColumnDefinition Width="120" MinWidth="120"/>
                                                            <ColumnDefinition Width="140" MinWidth="140"/>
                                                            <ColumnDefinition Width="130" MinWidth="130"/>
