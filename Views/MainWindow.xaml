                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2196F3"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Transform>
                                                                    <TranslateTransform X="12" Y="0"/>
                                                                </VisualBrush.Transform>
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Filtruj listę (nr, nazwa, NIP, wystawił, kwota…)"
                                                                               Foreground="#999999"
                                                                               FontStyle="Italic"
                                                                               Margin="0,8,0,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Content="Wyczyść" Command="{Binding ClearSubiektSearchCommand}" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Pobierz przygotowalnię" Command="{Binding FetchGlsPreparingBoxCommand}"
                                            Height="35" Margin="0,0,0,0"
                                            ToolTip="Pobiera przygotowalnię GLS i synchronizuje kolumnę Przygotowalnia oraz pole Przesylka"/>
                                </StackPanel>

                                <Border Width="1" Background="#D0D0D0" Margin="12,4" VerticalAlignment="Stretch"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
