<Window x:Class="Gryzak.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gryzak.ViewModels"
        xmlns:models="clr-namespace:Gryzak.Models"
        xmlns:converters="clr-namespace:Gryzak.Converters"
        mc:Ignorable="d"
        Title="Gryzak — Centrum Kontroli Lotów" 
        Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/gryzak_icon.png"
        MouseMove="Window_MouseMove"
        KeyDown="Window_KeyDown">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:ZKNumberFormatter x:Key="ZKNumberFormatter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:MinDoubleConverter x:Key="MinDoubleConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,0,4,0"
                                CornerRadius="4,4,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="HeaderContent"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontSize="13"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="#616161"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MainTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#F7F9FC"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TabPanel Grid.Column="0" IsItemsHost="True" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,6">
                                        <Image Source="pack://application:,,,/gryzak_icon.png"
                                               Width="28" Height="28" Margin="0,0,8,0"
                                               MouseDown="LogoImage_MouseDown"
                                               Cursor="Hand"
                                               ToolTip="Kliknij, aby zobaczyć duże logo"
                                               VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Gryzak"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#1565C0"
                                                       LineHeight="16"/>
                                            <TextBlock Text="Centrum Kontroli Lotów"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#546E7A"
                                                       LineHeight="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="_Plik">
                <MenuItem Header="Ustawienia sklepu" Command="{Binding ConfigureApiCommand}" InputGestureText="Ctrl+K"/>
                <MenuItem Header="Ustawienia Subiekt" Command="{Binding OpenSubiektSettingsCommand}"/>
                <MenuItem Header="Ustawienia GLS" Command="{Binding OpenGlsSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Środowisko">
                    <MenuItem Header="Test"
                              IsCheckable="True"
                              IsChecked="{Binding IsTestEnvironment, Mode=OneWay}"
                              Command="{Binding SetTestEnvironmentCommand}"/>
                    <MenuItem Header="Produkcja"
                              IsCheckable="True"
                              IsChecked="{Binding IsProductionEnvironment, Mode=OneWay}"
                              Command="{Binding SetProductionEnvironmentCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Zapisz ustawienia…" Command="{Binding ExportSettingsCommand}"/>
                <MenuItem Header="Wgraj ustawienia…" Command="{Binding ImportSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Debug" Click="DebugMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Zwolnij licencję Subiekta GT" Command="{Binding ZwolnijLicencjeCommand}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="IsEnabled" Value="{Binding IsSubiektActive}"/>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Zamknij" Click="CloseMenuItem_Click" InputGestureText="Ctrl+Q"/>
            </MenuItem>
            <MenuItem Header="_Akcje">
                <MenuItem Header="Odśwież" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                <MenuItem Header="Dodaj ZK" Command="{Binding DodajZKCommand}"/>
                <MenuItem Header="Nowe ZK" Command="{Binding NoweZKCommand}"/>
            </MenuItem>
            <MenuItem Header="_Historia">
                <MenuItem Header="Ostatnio otwarte zamówienia" ItemsSource="{Binding RecentOrders}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <EventSetter Event="Click" Handler="HistoryOrderItem_Click"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="Ostatnio otwarte zamówienia"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentOrders.Count}" Value="0">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Header" Value="Brak historii"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Narzędzia">
                <MenuItem Header="WyPLUwacz" Command="{Binding WyPLUwaczCommand}"/>
                <MenuItem Header="Przesyłki" Command="{Binding OpenGlsShipmentsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Pomoc">
                <MenuItem Header="O aplikacji" Click="AboutMenuItem_Click"/>
                <MenuItem Header="Readme" Click="ReadmeMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <TabControl Grid.Row="1"
                    Style="{StaticResource MainTabControlStyle}"
                    SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}"
                    Margin="0,8,0,0">
            <TabItem Header="Zamówienia internetowe">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBox Name="SearchTextBox" Width="300" Padding="10,8" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtruj listę lub wpisz numer zamówienia i kliknij lupę, aby pobrać z API.">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Command="{Binding FetchOrderFromApiCommand}"
                            ToolTip="Pobierz zamówienie po numerze (ID) z API — używa tekstu z pola wyszukiwania."
                            Width="38" Height="38" Margin="6,0,0,0" Padding="0"
                            Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1"
                            Cursor="Hand">
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#424242" Data="M15.5,14h-0.79l-0.28,-0.27A6.471,6.471 0 0 0 16,9.5 6.5,6.5 0 1 0 9.5,16c1.61,0 3.09,-0.59 4.23,-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99,-5zm-6,0C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Content="Wyczyść" Command="{Binding ClearSearchCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Name="StatusFilterComboBox" Width="200" SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Wszystkie statusy"/>
                        <ComboBoxItem Content="Nowe"/>
                        <ComboBoxItem Content="Zapłacono"/>
                        <ComboBoxItem Content="Wysłano"/>
                        <ComboBoxItem Content="Dostarczone"/>
                        <ComboBoxItem Content="Anulowane"/>
                    </ComboBox>
                    <Button Content="Dodaj ZK" Command="{Binding DodajZKCommand}" Background="#4CAF50" Margin="5,0,5,0" Height="35"/>
                    <Button Content="Odśwież" Command="{Binding RefreshCommand}" Height="35" Margin="5,0,5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela zamówień -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.Resources>
                <DataTemplate DataType="{x:Type models:Order}">
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10" Background="White" Margin="0,0,0,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" MinWidth="100"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="100" MinWidth="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" TextWrapping="Wrap">
                                <Run Text="{Binding Id}" FontWeight="SemiBold"/>
                                <LineBreak/>
                                <Run Text="{Binding SubiektDocumentNumber, Converter={StaticResource ZKNumberFormatter}}" FontSize="10" Foreground="#666666"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat='dd.MM.yyyy'}"/>
                            <Grid Grid.Column="2" ClipToBounds="True">
                                <StackPanel>
                                <TextBlock Text="{Binding Customer}" FontWeight="SemiBold"
                                           ToolTip="{Binding Customer}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding Email}" FontSize="11" Foreground="Gray"
                                           ToolTip="{Binding Email}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="Gray"
                                           ToolTip="{Binding Phone}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding Company, StringFormat='Firma: {0}'}" FontSize="11" Foreground="Gray"
                                           ToolTip="{Binding Company}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Company}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Column="3" Text="{Binding Status}"/>
                            <TextBlock Grid.Column="4" Text="{Binding PaymentStatus}"/>
                            <TextBlock Grid.Column="5" Text="{Binding CountryWithIso3}"/>
                            <TextBlock Grid.Column="6">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Total"/>
                                        <Binding Path="Currency"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Grid.Resources>

            <ScrollViewer Name="OrdersScrollViewer"
                          ScrollChanged="OrdersScrollViewer_ScrollChanged"
                          HorizontalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding HasOrders}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                
                <Grid Width="{Binding ViewportWidth, ElementName=OrdersScrollViewer, Converter={StaticResource MinDoubleConverter}, ConverterParameter=900}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Nagłówek kolumn -->
                    <Border Grid.Row="0" Background="#2196F3" Padding="10,8" BorderBrush="#1976D2" BorderThickness="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" MinWidth="100"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="120" MinWidth="120"/>
                                <ColumnDefinition Width="100" MinWidth="100"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="ID Zamówienia" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Data" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="2" Text="Klient" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="3" Text="Status zamówienia" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="4" Text="Status płatności" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="5" Text="Kraj" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="6" Text="Wartość" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    
                    <!-- Lista zamówień -->
                    <StackPanel Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding FilteredOrders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10" Margin="0,0,0,2" 
                                    MouseDown="OrderItem_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <!-- Hover -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                            <!-- Zaznaczone zamówienie - wyższy priorytet -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                <Setter Property="BorderBrush" Value="#64B5F6"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" TextWrapping="Wrap">
                                        <Run Text="{Binding Id}" FontWeight="SemiBold"/>
                                        <LineBreak/>
                                        <Run Text="{Binding SubiektDocumentNumber, Converter={StaticResource ZKNumberFormatter}}" FontSize="10" Foreground="#666666"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat='dd.MM.yyyy'}"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Customer}" FontWeight="SemiBold"/>
                                        <!-- Email - pokaż tylko po kliknięciu -->
                                        <TextBlock Text="{Binding Email}" FontSize="11" Foreground="Gray">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Phone - pokaż tylko po kliknięciu -->
                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="Gray">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- NIP - pokaż tylko po kliknięciu, w jednej linii, zielony gdy jest, czerwony gdy brak -->
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="NIP: " Foreground="#4CAF50"/>
                                            <Run>
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Text" Value="{Binding Nip}"/>
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Nip}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="Brak NIP"/>
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Nip}" Value="">
                                                                <Setter Property="Text" Value="Brak NIP"/>
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                        <!-- Company - widoczna zawsze, jeśli istnieje -->
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Company}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="Firma: "/>
                                            <Run Text="{Binding Company}"/>
                                        </TextBlock>
                                        <!-- Address - pokaż tylko po kliknięciu, jeśli istnieje -->
                                        <TextBlock Text="{Binding Address}" FontSize="11" Foreground="Gray">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Address}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Address}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Country - pokaż tylko po kliknięciu, jeśli istnieje -->
                                        <TextBlock Text="{Binding CountryWithIso3, StringFormat='Kraj: {0}'}" FontSize="11" Foreground="Gray">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CountryWithIso3}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CountryWithIso3}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PaymentStatus}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding CountryWithIso3}"/>
                                    <TextBlock Grid.Column="6">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Total"/>
                                                <Binding Path="Currency"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Wskaźnik ładowania więcej -->
                        <Border Visibility="{Binding IsLoadingMore, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                Background="#F5F5F5" Padding="15" Margin="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
