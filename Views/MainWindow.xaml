                                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Command="{Binding RefreshCommand}"
