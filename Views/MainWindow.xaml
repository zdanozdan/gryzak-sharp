                                        <ComboBoxItem Content="2 dni"/>
                                        <ComboBoxItem Content="3 dni"/>
                                        <ComboBoxItem Content="Tydzień"/>
                                        <ComboBoxItem Content="30 dni"/>
                                        <ComboBoxItem Content="Dowolny dzień"/>
                                        <ComboBoxItem Content="Dowolny zakres"/>
                                    </ComboBox>
                                    <DatePicker Width="120" Margin="5,0,0,0" Height="35"
