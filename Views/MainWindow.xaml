                                                Visibility="{Binding IsGlsPickupCustomDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <DatePicker Width="120" Margin="5,0,0,0" Height="35"
                                                SelectedDate="{Binding GlsPickupCustomFromDate}"
                                                ToolTip="Początek zakresu nadań GLS"
                                                Visibility="{Binding IsGlsPickupCustomRangeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
