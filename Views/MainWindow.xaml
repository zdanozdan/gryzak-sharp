                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubiektApiConfigured}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Konfiguracja wymagana" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="API Subiekt nie jest skonfigurowane. Ustaw URL API, aby zobaczyć dokumenty ZK/WZ/FS."
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Width="420" Margin="0,0,0,15"/>
                                <Button Content="Ustawienia Subiekt" Command="{Binding OpenSubiektSettingsCommand}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center"
                                        Visibility="{Binding EmptySubiektShowsNoDocuments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Brak dokumentów" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Nie znaleziono dokumentów wybranego typu." HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Pasek statusu -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Pasek postępu -->
            <Border Grid.Row="0" 
                    Background="#E3F2FD" 
                    BorderBrush="#2196F3" 
                    BorderThickness="0,0,0,1" 
                    Padding="10,8"
                    Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="{Binding ProgressText}" 
                               FontSize="11" 
                               Foreground="#1976D2" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressValue, StringFormat={}{0:0.#}%}"
                               FontSize="11"
                               Foreground="#1976D2"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ProgressBar Grid.Column="2" 
                                 Value="{Binding ProgressValue}" 
                                 Maximum="100"
                                 Height="10"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Status -->
            <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                        <Border CornerRadius="3" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FF9800"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductionEnvironment}" Value="True">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EnvironmentStatusText}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding StatusCountLabel}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusCountValue}" FontWeight="Bold" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SubiektStatusText}" FontSize="12" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubiektActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" 
                               FontSize="12" 
                               Foreground="#2196F3"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding StatusSelectedCaption}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatusSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding AppVersionText}" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

