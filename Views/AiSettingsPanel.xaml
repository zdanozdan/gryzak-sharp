<UserControl x:Class="Gryzak.Views.AiSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Połączenie z modelem językowym (LLM)"
                       FontSize="12"
                       Foreground="Gray"/>
            <TextBlock Text="Wspólna warstwa wywołań — zmiana dostawcy (Gemini, później Claude/Grok) nie wymaga przepisywania logiki aplikacji."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" Margin="0,0,0,20" Background="#F9F9F9">
                    <StackPanel>
                        <TextBlock Text="Dostawca" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2196F3"/>

                        <TextBlock Text="Dostawca:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Name="ProviderComboBox" SelectionChanged="ProviderComboBox_SelectionChanged"/>
                        <TextBlock Text="Na początek dostępny jest Google Gemini. Innych dostawców dodamy później."
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,-10,0,10"/>

                        <TextBlock Text="Nazwa modelu:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Name="ModelComboBox" IsEditable="True"/>
                        <TextBlock Text="Np. gemini-3.5-flash-lite, gemini-3.5-flash. Możesz wpisać własną nazwę."
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,-10,0,10"/>

                        <TextBlock Text="Klucz API:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <PasswordBox Name="ApiKeyPasswordBox"/>
                        <TextBlock Text="Klucz z Google AI Studio / Google Cloud (Gemini API)."
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,-10,0,10"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" Margin="0,0,0,20" Background="#F9F9F9">
                    <StackPanel>
                        <TextBlock Text="Parametry wywołania" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2196F3"/>

                        <TextBlock Text="Bazowy URL API (opcjonalnie):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Name="ApiBaseUrlTextBox" TextChanged="ApiBaseUrl_TextChanged"/>
                        <TextBlock Name="ApiBaseUrlPreview"
                                   FontSize="11"
                                   Foreground="#1565C0"
                                   TextWrapping="Wrap"
                                   Margin="0,-10,0,10"/>
                        <TextBlock Text="Puste = domyślny endpoint dostawcy. Użyj tylko przy proxy lub własnym gatewayu."
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Temperatura (0–2):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Name="TemperatureTextBox"/>
                        <TextBlock Text="Niższa = bardziej przewidywalne odpowiedzi, wyższa = bardziej kreatywne."
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,-10,0,10"/>

                        <TextBlock Text="Max. tokenów odpowiedzi:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Name="MaxOutputTokensTextBox"/>
                        <TextBlock Text="Limit długości odpowiedzi modelu. 0 = domyślna wartość dostawcy."
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,-10,0,10"/>

                        <TextBlock Text="Timeout (sekundy):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Name="TimeoutTextBox"/>
                        <TextBlock Text="Maksymalny czas oczekiwania na odpowiedź LLM (5–300)."
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,-10,0,10"/>

                        <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,6,0,0" Background="#F5F5F5">
                            <StackPanel>
                                <TextBlock Text="Test połączenia" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Button Name="TestConnectionButton"
                                        Content="🧪 Testuj AI"
                                        Click="TestConnectionButton_Click"
                                        HorizontalAlignment="Left"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="12,8"/>
                                <TextBlock Name="TestStatusText"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="🔄 Resetuj" Click="ResetButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
