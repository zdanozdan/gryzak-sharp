<Window x:Class="Gryzak.Views.GlsLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etykieta GLS"
        Height="720" Width="780"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/gryzak_icon.png">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#00897B" Padding="20,15">
            <StackPanel>
                <TextBlock Text="Etykieta GLS" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Name="SubtitleText"
                           FontSize="12"
                           Foreground="#E0F2F1"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FAFAFA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Name="PreviewScroll"
                                  Grid.Row="0"
                                  Margin="4"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="PreviewScroll_PreviewMouseWheel"
                                  SizeChanged="PreviewScroll_SizeChanged">
                        <Grid Name="PreviewHost"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                              MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Image Name="PreviewImage"
                                   Stretch="None"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.LayoutTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="PreviewRotate" Angle="0"/>
                                        <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                    </TransformGroup>
                                </Image.LayoutTransform>
                            </Image>
                        </Grid>
                    </ScrollViewer>

                    <TextBlock Name="PreviewStatusText"
                               Grid.Row="0"
                               Text="Ładowanie etykiety..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Margin="24"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8">
                        <Button Name="ZoomOutButton"
                                Content="−"
                                Width="40" MinWidth="40"
                                Padding="0,4"
                                Margin="2"
                                Click="ZoomOutButton_Click"
                                ToolTip="Pomniejsz (Ctrl + scroll)"/>
                        <Button Name="ZoomFitButton"
                                Content="Dopasuj"
                                MinWidth="80"
                                Padding="10,4"
                                Margin="2"
                                Click="ZoomFitButton_Click"
                                Background="#607D8B"
                                ToolTip="Dopasuj do okna"/>
                        <Button Name="ZoomInButton"
                                Content="+"
                                Width="40" MinWidth="40"
                                Padding="0,4"
                                Margin="2"
                                Click="ZoomInButton_Click"
                                ToolTip="Powiększ (Ctrl + scroll)"/>
                        <TextBlock Name="ZoomLevelText"
                                   Text="100%"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="#555555"
                                   MinWidth="48"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Orientacja podglądu:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Name="OrientationVerticalRadio"
                                         Content="Pionowa"
                                         GroupName="LabelOrientation"
                                         IsChecked="True"
                                         Checked="Orientation_Changed"/>
                            <RadioButton Name="OrientationHorizontalRadio"
                                         Content="Pozioma"
                                         GroupName="LabelOrientation"
                                         Checked="Orientation_Changed"/>
                            <TextBlock Text="Druk: ZPL (Zebra)"
                                       VerticalAlignment="Center"
                                       Foreground="#666666"
                                       FontSize="12"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Drukarka:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox Name="PrinterComboBox"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  VerticalContentAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <TextBlock Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           HorizontalAlignment="Left"
                           Margin="0,0,12,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="PrintButton"
                            Content="Drukuj"
                            Click="PrintButton_Click"
                            Background="#00897B"
                            IsEnabled="False"/>
                    <Button Content="Zamknij" Click="CloseButton_Click" IsCancel="True" Background="#E0E0E0" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
