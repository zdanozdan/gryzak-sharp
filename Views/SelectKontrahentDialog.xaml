<Window x:Class="Gryzak.Views.SelectKontrahentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Gryzak.Converters"
        Title="Wybierz kontrahenta"
        Height="520" Width="480"
        MinHeight="360" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/gryzak_icon.png">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Wybierz kontrahenta" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1"
                Padding="10,8" CornerRadius="4" Margin="0,0,0,10"
                Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HasOrderContext, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Szukano na podstawie zamówienia:" FontSize="10" Foreground="#666" Margin="0,0,0,4"/>
                <TextBlock Name="CustomerInfoTextBlock" FontSize="11" Foreground="#333" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ListBox Name="KontrahenciList"
                         BorderThickness="0"
                         SelectionMode="Single"
                         SelectionChanged="KontrahenciList_SelectionChanged"
                         MouseDoubleClick="KontrahenciList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EEEEEE"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNipMatch}" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13"
                                                   TextWrapping="Wrap" Foreground="#212121"/>
                                        <TextBlock Text="{Binding DisplayMeta}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding DisplayMeta, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding DisplayAddress}" FontSize="11" Foreground="#888"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding DisplayAddress, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top"
                                                Margin="8,0,0,0">
                                        <Border Background="#43A047" CornerRadius="3" Padding="6,2" Margin="0,0,0,4"
                                                Visibility="{Binding IsNipMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="NIP" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#1E88E5" CornerRadius="3" Padding="6,2" Margin="0,0,0,4"
                                                Visibility="{Binding IsEmailMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="E-mail" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#FB8C00" CornerRadius="3" Padding="6,2" Margin="0,0,0,4"
                                                Visibility="{Binding IsNameMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Nazwa" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#8E24AA" CornerRadius="3" Padding="6,2"
                                                Visibility="{Binding IsCompanyMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Firma" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Name="EmptyListText"
                           Text="Nie znaleziono kontrahentów."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontSize="12"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Name="ZkActionsPanel">
                <Button Name="AddButton" Content="Nowy" Click="AddButton_Click"
                        Background="#4CAF50" Foreground="White"/>
                <Button Name="EmptyButton" Content="Pusty" Click="EmptyButton_Click"
                        Background="#FF9800" Foreground="White"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="SelectButton" Content="Wybierz" Click="SelectButton_Click"
                        IsDefault="True" IsEnabled="False"
                        Background="#2196F3" Foreground="White"/>
                <Button Content="Anuluj" Click="CancelButton_Click" IsCancel="True"
                        Background="#E0E0E0" Foreground="Black"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
