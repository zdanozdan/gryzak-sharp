<Window x:Class="Gryzak.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⚙️ Ustawienia"
        Height="720" Width="640"
        MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/gryzak_icon.png">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚙️ Ustawienia" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Sklep, Subiekt, GLS i AI w jednym miejscu"
                       FontSize="12"
                       Foreground="Gray"/>
        </StackPanel>

        <TabControl Name="SettingsTabControl" Grid.Row="1">
            <TabItem Name="ShopTab" Header="Ustawienia sklepu">
                <ContentControl Name="ShopContentHost"/>
            </TabItem>
            <TabItem Name="SubiektTab" Header="Ustawienia Subiekt">
                <ContentControl Name="SubiektContentHost"/>
            </TabItem>
            <TabItem Name="GlsTab" Header="Ustawienia GLS">
                <ContentControl Name="GlsContentHost"/>
            </TabItem>
            <TabItem Name="AiTab" Header="AI">
                <ContentControl Name="AiContentHost"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="💾 Zapisz" Click="SaveButton_Click" IsDefault="True"
                    Background="#2196F3" Foreground="White" BorderThickness="0"/>
            <Button Content="Anuluj" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
