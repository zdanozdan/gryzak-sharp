<Window x:Class="Gryzak.Views.KontrahentDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Gryzak.Converters"
        Title="Podgląd kontrahenta"
        Height="640" Width="520"
        MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/gryzak_icon.png">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" Padding="20,14">
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="#E3F2FD" Margin="0,4,0,0"
                           Visibility="{Binding HeaderSubtitle, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Dane ogólne" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IdDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="ID" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding IdDisplay}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Symbol, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Symbol" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Symbol}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding TypNazwa, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Typ" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TypNazwa}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Email, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Email}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Adres podstawowy" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding NazwaPelna, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Nazwa pełna" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding NazwaPelna}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Nazwa, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Nazwa" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Nazwa}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Nip, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="NIP" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Nip}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Adres, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Adres" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Adres}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Ulica, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Ulica" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Ulica}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Kod, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Kod" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Kod}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Miejscowosc, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Miejscowość" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Miejscowosc}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Poczta, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Poczta" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Poczta}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Telefon, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Telefon}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Panstwo, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Państwo" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Panstwo}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Wojewodztwo, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Województwo" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Wojewodztwo}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,12"
                        Visibility="{Binding HasAdresKorespondencyjny, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Adres korespondencyjny" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyNazwaPelna, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Nazwa pełna" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyNazwaPelna}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyNazwa, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Nazwa" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyNazwa}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyNip, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="NIP" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyNip}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyAdres, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Adres" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyAdres}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyUlica, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Ulica" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyUlica}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyKod, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Kod" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyKod}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyMiejscowosc, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Miejscowość" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyMiejscowosc}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyTelefon, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyTelefon}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding KorespondencyjnyPanstwo, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Państwo" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding KorespondencyjnyPanstwo}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#4CAF50" BorderThickness="4,0,0,0" Background="#F1F8E9" Padding="14,12" CornerRadius="0,4,4,0"
                        Visibility="{Binding HasAdresDostawy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Adres dostawy" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaNazwaPelna, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Nazwa pełna" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaNazwaPelna}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaNazwa, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Nazwa" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaNazwa}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaNip, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="NIP" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaNip}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaAdres, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Adres" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaAdres}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaUlica, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Ulica" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaUlica}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaKod, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Kod" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaKod}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaMiejscowosc, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Miejscowość" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaMiejscowosc}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaTelefon, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaTelefon}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DostawaPanstwo, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="Państwo" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DostawaPanstwo}" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,12">
            <Button Content="Zamknij" IsDefault="True" IsCancel="True" Click="CloseButton_Click"
                    HorizontalAlignment="Right" Width="120" Height="35"/>
        </Border>
    </Grid>
</Window>
