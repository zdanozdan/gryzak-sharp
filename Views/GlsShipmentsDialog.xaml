<Window x:Class="Gryzak.Views.GlsShipmentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Przesyłki GLS (cache SQLite)"
        Height="560" Width="980"
        MinHeight="400" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/gryzak_icon.png">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Name="SearchGlsButton"
                        Content="Szukaj w GLS"
                        Padding="12,6"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Click="SearchGlsButton_Click"/>
                <Button Name="RefreshButton"
                        Content="Odśwież"
                        Padding="12,6"
                        MinWidth="90"
                        Click="RefreshButton_Click"/>
            </StackPanel>
            <TextBlock Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Text="Ładowanie…"/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  Name="ShipmentsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F7F9FC"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Typ" Binding="{Binding TypKod}" Width="50"/>
                <DataGridTextColumn Header="Nr dokumentu" Binding="{Binding NrPelny}" Width="140"/>
                <DataGridTextColumn Header="dok_id" Binding="{Binding DokId}" Width="80"/>
                <DataGridTextColumn Header="Carrier" Binding="{Binding Carrier}" Width="70"/>
                <DataGridTextColumn Header="box_id" Binding="{Binding BoxId}" Width="80"/>
                <DataGridTextColumn Header="nr_przyg" Binding="{Binding NrPrzyg}" Width="*"/>
                <DataGridTextColumn Header="nr_nad" Binding="{Binding NrNad}" Width="*"/>
                <DataGridTextColumn Header="updated_at" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Zamknij"
                    IsCancel="True"
                    Padding="15,8"
                    MinWidth="100"
                    Click="CloseButton_Click"/>
            <TextBlock Name="DbPathText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#888"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
