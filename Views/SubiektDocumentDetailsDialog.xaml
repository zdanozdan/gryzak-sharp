<Window x:Class="Gryzak.Views.SubiektDocumentDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Gryzak.Models"
        xmlns:converters="clr-namespace:Gryzak.Converters"
        mc:Ignorable="d"
        Title="Szczegóły dokumentu"
        Height="900" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="700"
        MinHeight="680"
        Icon="pack://application:,,,/gryzak_icon.png">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <!-- Read-only TextBox wyglądający jak TextBlock — pozwala zaznaczać i kopiować -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DocumentNumber, StringFormat='Dokument: {0}'}"
                               FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding CustomerName}"
                               FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1"
                                Visibility="{Binding CustomerNip, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="NIP: " FontSize="11" Foreground="#E3F2FD"/>
                        <TextBlock Text="{Binding CustomerNip}" FontSize="11" Foreground="#E3F2FD"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1"
                                Visibility="{Binding OriginalNumber, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="Numer oryginalny: " FontSize="11" Foreground="#E3F2FD"/>
                        <TextBlock Text="{Binding OriginalNumber}" FontSize="11" Foreground="#E3F2FD"/>
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0"
                                Visibility="{Binding HasRelatedDocuments, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Dokumenty powiązane"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#BBDEFB" Margin="0,0,0,1"/>
                        <ItemsControl ItemsSource="{Binding RelatedDocuments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SubiektRelatedDocument}">
                                    <TextBlock Text="{Binding NrPelny}"
                                               FontSize="12"
                                               Foreground="#FFF59D"
                                               TextDecorations="Underline"
                                               Cursor="Hand"
                                               Margin="0,1,0,0"
                                               ToolTip="Otwórz szczegóły dokumentu"
                                               MouseLeftButtonUp="RelatedDocument_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Name="WaybillButton"
                            Content="Przygotowalnia GLS"
                            Click="CreateWaybillButton_Click"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Padding="12,6"
                            MinWidth="150"
                            Background="White"
                            Foreground="#1565C0"
                            FontWeight="SemiBold"
                            Visibility="{Binding IsGlsPanelEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding WaybillStatusText}"
                               FontSize="11"
                               Foreground="#FFF9C4"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding WaybillStatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                    <TextBlock Text="{Binding DocumentDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#E3F2FD" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11" Foreground="#E3F2FD" Margin="0,0,0,2">
                        <Run Text="Status: " Foreground="#BBDEFB"/>
                        <Run Text="{Binding StatusName}" Foreground="#E3F2FD"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#E3F2FD"
                               Visibility="{Binding CustomerAddress, Converter={StaticResource StringToVisibilityConverter}}">
                        <Run Text="Adres: " Foreground="#BBDEFB"/>
                        <Run Text="{Binding CustomerAddress}" Foreground="#E3F2FD"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <Border x:Name="GlsSection" Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Przygotowalnia GLS"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#1565C0"
                               Margin="0,0,0,6"/>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="PreparingBoxScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Visibility="{Binding ShowPreparingBoxList, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl x:Name="PreparingBoxItemsControl" ItemsSource="{Binding PreparingBoxItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GlsPreparingBoxItem}">
                                        <Border Background="#E3F2FD" CornerRadius="4" Padding="8,6" Margin="0,0,8,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1565C0"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="11"
                                                           Foreground="#555"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Brak przesyłek w przygotowalni."
                                   Foreground="#888"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowPreparingBoxEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Nadania GLS"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#2E7D32"
                               Margin="0,0,0,6"/>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="PickupScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Visibility="{Binding ShowPickupList, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl x:Name="PickupItemsControl" ItemsSource="{Binding PickupItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GlsPickupItem}">
                                        <Border Background="#E8F5E9" CornerRadius="4" Padding="8,6" Margin="0,0,8,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2E7D32"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="11"
                                                           Foreground="#555"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Brak nadań."
                                   Foreground="#888"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowPickupEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Grid>

                <Border Grid.ColumnSpan="3"
                        Background="#E6FAFAFA"
                        Visibility="{Binding IsGlsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Sprawdzanie GLS…"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <ProgressBar IsIndeterminate="True" Width="180" Height="16"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ProductsSection" Grid.Row="1" Margin="16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F5F5F5" Padding="10,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PLU" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Symbol" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Towar" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Ilość" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Cena netto" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="Cena brutto" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="Wartość brutto" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="LinesScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          CanContentScroll="False">
                <ItemsControl x:Name="LinesItemsControl" ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SubiektDocumentLine}">
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Plu}" HorizontalAlignment="Center" Foreground="#666"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="#666"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Nazwa}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Ilosc, StringFormat=N2}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding CenaNetto, StringFormat=N2}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding CenaBrutto, StringFormat=N2}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="{Binding WartoscBrutto, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" Padding="8,6"
                        Visibility="{Binding PayerName, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,2">
                            <TextBlock Text="Płatnik" FontWeight="Bold" Foreground="#666"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}"
                                    Click="OpenPayerInSubiektButton_Click"
                                    ToolTip="Otwórz kartotekę płatnika w Subiekcie GT (Sfera)">
                                <TextBlock Text="&#xE8A7;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0"/>
                            </Button>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}"
                                    Click="OpenPayerDetailsButton_Click"
                                    ToolTip="Pokaż dane płatnika"
                                    Margin="8,0,0,0">
                                <TextBlock Text="&#xE8F1;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0"/>
                            </Button>
                        </DockPanel>
                        <TextBox Text="{Binding PayerName, Mode=OneWay}" Style="{StaticResource SelectableText}"/>
                        <TextBox Text="{Binding PayerNip, Mode=OneWay, StringFormat=NIP: {0}}"
                                 Style="{StaticResource SelectableText}"
                                 Visibility="{Binding PayerNip, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBox Text="{Binding PayerAddress, Mode=OneWay}"
                                 Style="{StaticResource SelectableText}"
                                 Visibility="{Binding PayerAddress, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                        BorderBrush="#4CAF50" BorderThickness="4,0,0,0" Padding="10,0,0,0"
                        Visibility="{Binding HasShippingAddress, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Adres wysyłki" FontWeight="Bold" Foreground="#2E7D32"/>
                        <TextBox Text="{Binding ShippingAddressName, Mode=OneWay}"
                                 Style="{StaticResource SelectableText}"
                                 Visibility="{Binding ShippingAddressName, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBox Text="{Binding ShippingAddress, Mode=OneWay}"
                                 Style="{StaticResource SelectableText}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Netto:"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalNet, StringFormat=N2}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Brutto:" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalGross, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="#2196F3"/>
                    </Grid>
                    <Grid Margin="0,6,0,0"
                          Visibility="{Binding Payment, Converter={StaticResource StringToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Płatność:" Foreground="#666"/>
                        <TextBlock Grid.Column="1" Text="{Binding Payment}" Foreground="#333" FontWeight="SemiBold" MaxWidth="200" TextWrapping="Wrap" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zamknij" IsDefault="True" Click="CloseButton_Click" Width="120" Height="35"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
